SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Optional fallback if SUPABASE_SERVICE_KEY is not set
SUPABASE_SERVICE_ROLE_KEY=

# Academy dev server port
PORT=4100

# Pose estimation model: movenet or blazepose
ACADEMY_POSE_MODEL=movenet

# Coaching model used for analysis summaries
ACADEMY_COACH_MODEL=claude-fable-5
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: explicit ffmpeg binary path override
FFMPEG_PATH=
